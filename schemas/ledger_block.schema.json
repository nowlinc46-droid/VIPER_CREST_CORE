{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViperCrestAcademicLedgerBlock",
  "description": "Schema for deterministic append-only ViperCrest Academic Copy Provenance Record ledger blocks.",
  "type": "object",
  "required": [
    "schema_version",
    "block_index",
    "copy_id",
    "product",
    "product_version",
    "release_commit",
    "recipient_class",
    "recipient_name",
    "recipient_department",
    "license_class",
    "commercial_rights",
    "equity_rights",
    "profit_rights",
    "transferable",
    "redistribution_rights",
    "issuance_authority",
    "donation_price_usd",
    "artifact_sha256",
    "manifest_sha256",
    "license_sha256",
    "public_key_fingerprint",
    "previous_block_hash",
    "created_utc",
    "issuer_status",
    "public_anchor_status",
    "recipient_acceptance_status",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "block_index": { "type": "integer", "minimum": 0 },
    "copy_id": { "type": "string", "pattern": "^(VC-ACADEMIC-GENESIS|VC-ACADEMIC-[0-9]{6})$" },
    "product": { "type": "string", "enum": ["ViperCrest"] },
    "product_version": { "type": "string" },
    "release_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "recipient_class": { "type": "string", "enum": ["GENESIS", "UNIVERSITY", "STUDENT", "HEALTHCARE"] },
    "recipient_name": { "type": "string" },
    "recipient_department": { "type": "string" },
    "license_class": { "type": "string", "enum": ["GENESIS_PROVENANCE", "ACADEMIC_RESEARCH"] },
    "commercial_rights": { "type": "boolean", "enum": [false] },
    "equity_rights": { "type": "boolean", "enum": [false] },
    "profit_rights": { "type": "boolean", "enum": [false] },
    "transferable": { "type": "boolean", "enum": [false] },
    "redistribution_rights": { "type": "boolean", "enum": [false] },
    "issuance_authority": { "type": "boolean", "enum": [false] },
    "donation_price_usd": { "type": "integer", "enum": [0] },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "license_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "sbom_sha256": { "type": ["string", "null"] },
    "public_key_fingerprint": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "previous_block_hash": { "type": "string", "pattern": "^(0{64}|[0-9a-fA-F]{64})$" },
    "created_utc": { "type": "string", "format": "date-time" },
    "issuer_status": { "type": "string", "enum": ["GENESIS_ANCHOR", "PENDING_OFFLINE_SIGNATURE", "SIGNED"] },
    "issuer_signature": { "type": ["string", "null"] },
    "public_anchor_status": { "type": "string", "enum": ["NOT_ANCHORED", "EXPORTED_ANCHOR", "ANCHORED"] },
    "public_anchor_reference": { "type": ["string", "null"] },
    "recipient_acceptance_status": { "type": "string", "enum": ["NOT_APPLICABLE", "PENDING", "ACKNOWLEDGED", "ACCEPTED"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
