{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DonationManifest",
  "description": "Manifest accompanying an academic donation deliverable.",
  "type": "object",
  "required": [
    "manifest_version",
    "copy_id",
    "product",
    "product_version",
    "release_commit",
    "package_created_utc",
    "recipient_class",
    "recipient_name",
    "recipient_department",
    "license_class",
    "commercial_rights",
    "equity_rights",
    "issuance_authority",
    "public_verification_key_fingerprint",
    "files"
  ],
  "properties": {
    "manifest_version": { "type": "string", "enum": ["1.0"] },
    "copy_id": { "type": "string" },
    "product": { "type": "string", "enum": ["ViperCrest"] },
    "product_version": { "type": "string" },
    "release_commit": { "type": "string" },
    "package_created_utc": { "type": "string", "format": "date-time" },
    "recipient_class": { "type": "string" },
    "recipient_name": { "type": "string" },
    "recipient_department": { "type": "string" },
    "license_class": { "type": "string" },
    "commercial_rights": { "type": "boolean", "enum": [false] },
    "equity_rights": { "type": "boolean", "enum": [false] },
    "issuance_authority": { "type": "boolean", "enum": [false] },
    "public_verification_key_fingerprint": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    }
  },
  "additionalProperties": false
}
