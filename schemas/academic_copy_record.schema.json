{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcademicCopyRecord",
  "description": "Registry record schema for an issued or pending academic research copy of ViperCrest.",
  "type": "object",
  "required": [
    "copy_id",
    "status",
    "recipient_class",
    "recipient_name",
    "recipient_department",
    "license_class",
    "donation_price_usd",
    "created_utc",
    "artifact_zip_sha256",
    "ledger_block_index",
    "ledger_block_hash"
  ],
  "properties": {
    "copy_id": { "type": "string", "pattern": "^VC-ACADEMIC-[0-9]{6}$" },
    "status": { "type": "string", "enum": ["PREPARED_FOR_DONATION", "PENDING_OFFLINE_SIGNATURE", "ISSUED", "DONATED", "ACKNOWLEDGED"] },
    "recipient_class": { "type": "string", "enum": ["UNIVERSITY", "STUDENT", "HEALTHCARE"] },
    "recipient_name": { "type": "string" },
    "recipient_department": { "type": "string" },
    "license_class": { "type": "string", "enum": ["ACADEMIC_RESEARCH"] },
    "donation_price_usd": { "type": "integer", "enum": [0] },
    "created_utc": { "type": "string", "format": "date-time" },
    "artifact_zip_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "ledger_block_index": { "type": "integer", "minimum": 1 },
    "ledger_block_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  },
  "additionalProperties": false
}
